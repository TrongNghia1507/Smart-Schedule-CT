# ===== 1. Cấu hình Admin & HTTPS cho Web React =====
# Mật khẩu tài khoản `admin` (tối thiểu 6 ký tự) dùng đăng nhập tại /app/admin
SCHEDULE_ADMIN_PASSWORD=change-me-admin-2026
# Đặt true khi deploy lên HTTPS (Render, Railway, VPS có SSL)
SCHEDULE_SECURE_COOKIE=false

# ===== 2. Cấu hình Database MySQL / TiDB Cloud Starter =====
# Để trống DB_HOST nếu muốn dùng SQLite nội bộ (.data/portal.db).
# Điền thông số TiDB Cloud khi deploy lên Render Free để giữ dữ liệu vĩnh viễn!
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=smart_schedule_ct
DB_SSL=true
DB_SSL_CA=

# ===== 3. Cấu hình Solver & OpenRouter AI =====
TZ=Asia/Ho_Chi_Minh
CPSAT_WORKERS=1
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=20
